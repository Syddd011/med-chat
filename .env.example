# ─────────────────────────────────────────────────────────────────────────────
#  MediBot — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the real .env file to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a strong secret key:  python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_very_long_random_secret_key_here
FLASK_DEBUG=false

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Pinecone vector database (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here

# OpenRouter API key (used for LLM + Vision model calls)
# Get yours at: https://openrouter.ai/keys
OPENAI_API_KEY=your_openrouter_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (default — good for development/small deployments)
# For production: use PostgreSQL
# DATABASE_URL=postgresql://medibot_user:strong_password@localhost:5432/medibot_db
DATABASE_URL=

# ── Redis Cache ───────────────────────────────────────────────────────────────
# Leave empty to use in-memory cache (single instance only)
# For production with multiple workers: use Redis
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8080
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# The email address of the admin user who can access /admin
ADMIN_EMAIL=your_admin_email@example.com

# ── Docker / Deployment ───────────────────────────────────────────────────────
# Only needed for docker-compose production stack
POSTGRES_PASSWORD=change_this_very_strong_password
