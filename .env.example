# ─────────────────────────────────────────────────────────────────────────────
#  MediBot — Environment Variables Template
#  Copy this file to .env and fill in your own values.
#  NEVER commit the real .env file to version control.
#  Generate a new secret key: python -c "import secrets; print(secrets.token_hex(32))"
# ─────────────────────────────────────────────────────────────────────────────

# ── Flask ─────────────────────────────────────────────────────────────────────
# REQUIRED — app will not start without this
FLASK_SECRET_KEY=your_very_long_random_secret_key_here_at_least_32_chars
FLASK_DEBUG=false
FLASK_ENV=production

# ── AI APIs ───────────────────────────────────────────────────────────────────
# Pinecone vector database (https://app.pinecone.io)
PINECONE_API_KEY=your_pinecone_api_key_here

# OpenRouter API key (used for LLM + Vision model calls via OpenRouter)
# Get yours at: https://openrouter.ai/keys
OPENAI_API_KEY=your_openrouter_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Leave empty to use SQLite (development only — NOT for production)
# For production: use PostgreSQL
# DATABASE_URL=postgresql://medibot_user:strong_password@localhost:5432/medibot_db
DATABASE_URL=

# ── Redis Cache & Rate Limiter ────────────────────────────────────────────────
# REQUIRED in multi-worker production (rate limiter and cache share state)
# Without Redis, each Gunicorn worker has its own state — limits won't work correctly
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_WORKERS=4
GUNICORN_BIND=0.0.0.0:8080
GUNICORN_TIMEOUT=120
LOG_LEVEL=info

# ── Admin Dashboard ───────────────────────────────────────────────────────────
# The email address of the admin user who can access /admin
ADMIN_EMAIL=your_admin_email@example.com

# ── APM & Monitoring ──────────────────────────────────────────────────────────
# Get your Sentry DSN at https://sentry.io
# Leave empty to disable Sentry (no error tracking)
SENTRY_DSN=

# ── Docker / Deployment ───────────────────────────────────────────────────────
# Only needed for docker-compose production stack
POSTGRES_PASSWORD=change_this_to_a_very_strong_password_minimum_20_chars
