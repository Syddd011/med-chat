### Step 6 — LLM Reliability & Fallback Chain

```python
# Replace single model with fallback chain
from langchain.chat_models import ChatOpenAI
from langchain_core.language_models import BaseLanguageModel

def build_llm_with_fallback() -> BaseLanguageModel:
    primary = ChatOpenAI(
        model="openai/gpt-4o-mini",       # Upgrade from gpt-3.5-turbo
        openai_api_key=OPENAI_API_KEY,
        openai_api_base="https://openrouter.ai/api/v1",
        max_tokens=600,
        request_timeout=20,
    )
    fallback = ChatOpenAI(
        model="anthropic/claude-3-haiku", # Fallback on OpenRouter
        openai_api_key=OPENAI_API_KEY,
        openai_api_base="https://openrouter.ai/api/v1",
        max_tokens=600,
        request_timeout=20,
    )
    return primary.with_fallbacks([fallback])
```

